# App server
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# Database
DATABASE_URL=postgresql://paydoc:paydoc@localhost:5432/paydoc

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=payment_documents

# Knowledge base chunking
KNOWLEDGE_BASE_CHUNK_SIZE=1600
KNOWLEDGE_BASE_CHUNK_OVERLAP=200

# Embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Local OpenAI-compatible LLM
LOCAL_LLM_MODEL=qwen3-1.7b
LOCAL_LLM_OPENAI_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_API_KEY=not-needed
LOCAL_LLM_TIMEOUT_SECONDS=90
LOCAL_LLM_TEMPERATURE=0.2
LOCAL_LLM_MAX_TOKENS=700
LOCAL_LLM_ENABLE_THINKING=false
LOCAL_LLM_PROMPT_PREFIX=/no_think

# llama.cpp Docker server
LLAMACPP_HF_REPO=Qwen/Qwen3-1.7B-GGUF:Q8_0
LLAMACPP_CONTEXT_SIZE=4096
LLAMACPP_PREDICT_TOKENS=700

# Document intelligence models
DOCUMENT_CLASSIFIER_MODEL_PATH=data/models/distilbert-base-uncased-finetuned-document-classification
ENTITY_EXTRACTOR_MODEL_PATH=data/models/distilbert-base-cased-finetuned-entity-extraction

# Retrieval
RETRIEVER_RESULT_LIMIT=5
SCORE_THRESHOLD=0.6

# PDF parsing and OCR
PDF_MIN_TEXT_CHARS=20
PDF_USE_OCR=true
PDF_FORCE_OCR=false
PDF_OCR_DPI=200
PDF_OCR_LANG=eng
